<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="NeuralNetUI"
           Manufacturer="NeuralNetUI"
           Version="1.4.0"
           UpgradeCode="8D444D86-37C2-4E37-B56B-6BB9CD2C62BD"
           Language="1033"
           Codepage="949"
           Scope="perMachine">
    <SummaryInformation Description="NeuralNetUI Windows service and tray application" Manufacturer="NeuralNetUI" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of NeuralNetUI is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Property Id="ACCESS_MODE" Value="lan-and-tailscale" Secure="yes" />
    <Property Id="APP_PORT" Value="65500" Secure="yes" />
    <Launch Condition="Installed OR (APP_PORT &gt;= 1 AND APP_PORT &lt;= 65535)"
            Message="The listening port must be between 1 and 65535." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Neural Chat">
        <Directory Id="APPDIR" Name="app" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="CONFIGDIR" Name="Neural Chat">
        <Directory Id="DATADIR" Name="data" />
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="NeuralNetUI" Level="1">
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentRef Id="ServiceComponent" />
      <ComponentRef Id="TrayComponent" />
      <ComponentRef Id="DataDirectories" />
    </Feature>

    <CustomAction Id="ConfigureHosting"
                  FileRef="ServiceHostExe"
                  ExeCommand="--configure &quot;[CONFIGDIR]app-config.json&quot; &quot;[ACCESS_MODE]&quot; &quot;[APP_PORT]&quot;"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />
    <CustomAction Id="RemoveFirewall"
                  FileRef="ServiceHostExe"
                  ExeCommand="--remove-firewall"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />
    <CustomAction Id="StopTray"
                  Directory="SystemFolder"
                  ExeCommand="taskkill.exe /F /IM NeuralNetUI.Tray.exe"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />
    <CustomAction Id="LaunchTray"
                  FileRef="TrayHostExe"
                  ExeCommand="--open"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="asyncNoWait" />

    <InstallExecuteSequence>
      <Custom Action="ConfigureHosting" After="InstallFiles" Condition="NOT Installed" />
      <Custom Action="StopTray" Before="RemoveFiles" Condition="REMOVE = &quot;ALL&quot;" />
      <Custom Action="RemoveFirewall" Before="RemoveFiles" Condition="REMOVE = &quot;ALL&quot;" />
    </InstallExecuteSequence>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="installer\License.rtf" />

    <UI>
      <Dialog Id="HostingDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="yes" Text="WixUI_Bmp_Banner" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="300" Height="15" Transparent="yes" NoPrefix="yes" Text="Hosting access" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="320" Height="25" Transparent="yes" NoPrefix="yes" Text="Choose which nearby networks may connect. Internet clients are always rejected." />
        <Control Id="AccessLabel" Type="Text" X="20" Y="60" Width="330" Height="15" Text="Allowed networks:" />
        <Control Id="AccessMode" Type="RadioButtonGroup" X="25" Y="78" Width="320" Height="55" Property="ACCESS_MODE">
          <RadioButtonGroup Property="ACCESS_MODE">
            <RadioButton Value="lan-and-tailscale" X="0" Y="0" Width="290" Height="17" Text="LAN and Tailscale (recommended)" />
            <RadioButton Value="lan" X="0" Y="18" Width="290" Height="17" Text="LAN only" />
            <RadioButton Value="tailscale" X="0" Y="36" Width="290" Height="17" Text="Tailscale only" />
          </RadioButtonGroup>
        </Control>
        <Control Id="PortLabel" Type="Text" X="20" Y="148" Width="90" Height="15" Text="Listening port:" />
        <Control Id="Port" Type="Edit" X="110" Y="145" Width="70" Height="18" Property="APP_PORT" Integer="yes" />
        <Control Id="Note" Type="Text" X="20" Y="174" Width="330" Height="38" Text="Setup installs an automatic Windows service. The same options can later be changed in %ProgramData%\Neural Chat\app-config.json; restart the Neural Chat service after editing." />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="&amp;Back">
          <Publish Event="NewDialog" Value="InstallDirDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="&amp;Next">
          <Publish Event="NewDialog" Value="VerifyReadyDlg" Condition="APP_PORT &gt;= 1 AND APP_PORT &lt;= 65535" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="HostingDlg" Order="5" Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="HostingDlg" Order="5" Condition="NOT Installed" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchTray" Order="1" Condition="NOT Installed" />
    </UI>
  </Package>

  <Fragment>
    <ComponentGroup Id="ApplicationFiles" Directory="APPDIR">
      <Files Include="$(var.StagePath)\app\**" />
    </ComponentGroup>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="ServiceComponent" Guid="4AEEC587-7541-4A88-9B11-7207FF4A4DC0" Bitness="always64">
        <File Id="ServiceHostExe" Source="$(var.StagePath)\NeuralChatService.exe" KeyPath="yes" />
        <File Id="BundledNodeExe" Source="$(var.StagePath)\node.exe" />
        <ServiceInstall Id="ServiceInstaller"
                        Name="NeuralChat"
                        DisplayName="NeuralNetUI Service"
                        Description="Hosts NeuralNetUI for approved LAN and Tailscale clients."
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="LocalSystem"
                        Arguments="--service --config &quot;[CONFIGDIR]app-config.json&quot; --data &quot;[CONFIGDIR]data&quot;" />
        <ServiceControl Id="ServiceControl"
                        Name="NeuralChat"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>
      <Component Id="TrayComponent" Guid="E3B49521-9F0F-45BC-A790-12E3EC34F86A" Bitness="always64">
        <File Id="TrayHostExe" Source="$(var.StagePath)\NeuralNetUI.Tray.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut"
                    Directory="ProgramMenuFolder"
                    Name="NeuralNetUI"
                    Description="NeuralNetUI Web UI 열기"
                    WorkingDirectory="INSTALLFOLDER"
                    Arguments="--open"
                    Advertise="yes" />
        </File>
        <RegistryValue Root="HKLM"
                       Key="Software\Microsoft\Windows\CurrentVersion\Run"
                       Name="NeuralNetUI"
                       Value="&quot;[#TrayHostExe]&quot; --startup"
                       Type="string" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="CONFIGDIR">
      <Component Id="DataDirectories" Guid="F89ECFE2-B47F-4E5F-A0C7-705215271A55" Bitness="always64" Permanent="yes">
        <CreateFolder />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
