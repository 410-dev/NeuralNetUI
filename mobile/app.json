{
  "expo": {
    "name": "NeuralNetUI",
    "slug": "neuralnetui",
    "version": "0.2.3",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0a0c",
    "ios": {
      "bundleIdentifier": "dev.hysong.neuralnetui",
      "supportsTablet": true
    },
    "android": {
      "package": "dev.hysong.neuralnetui",
      "versionCode": 5,
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0c",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#0a0a0c"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2f8ff0"
        }
      ]
    ]
  }
}
